{
  "manifest_version": 3,
  "name": "Redactor - ChatGPT Security Guard",
  "version": "1.0",
  "description": "Intercepts and redacts sensitive data before sending prompts to ChatGPT.",
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://*.chatgpt.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}
